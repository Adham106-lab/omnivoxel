{
  "name": "omnivoxel",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic modular hardware/computing compiler and verifier engine",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "npm run typecheck --workspace=apps/web"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
